<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target framework, language version and analyzers come from src/Directory.Build.props. -->

  <PropertyGroup>
    <!-- An async test returns Task only because the framework requires it; code-csharp-mstest says not to document it. -->
    <NoWarn>$(NoWarn);SA1615</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="MSTest" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiCloud.Adapter.Notes\MultiCloud.Adapter.Notes.csproj" />
    <ProjectReference Include="..\MultiCloud.Adapter.Platform\MultiCloud.Adapter.Platform.csproj" />
    <ProjectReference Include="..\MultiCloud.Application.Web\MultiCloud.Application.Web.csproj" />
    <ProjectReference Include="..\MultiCloud.Orchestrator.Heartbeat\MultiCloud.Orchestrator.Heartbeat.csproj" />
  </ItemGroup>

</Project>
