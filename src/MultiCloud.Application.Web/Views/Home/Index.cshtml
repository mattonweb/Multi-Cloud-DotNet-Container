@model HomePage
@{
    // The page is read-only: no script, no form, and nothing loaded from another site.
    const string NotSupplied = "not supplied";
    PlatformDescription platform = Model.Platform;
    ApplicationSession session = Model.Session;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Multi-Cloud DotNet Container</title>
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>
    <main>
        <h1>Multi-Cloud DotNet Container</h1>
        <p class="lead">A placeholder application for checking that a platform is wired correctly.</p>

        <section>
            <h2>Where it is running</h2>
            <dl>
                <dt>Platform</dt>
                <dd>@platform.Name.Value</dd>
                <dt>Cloud provider</dt>
                <dd>@(platform.CloudProvider?.Value ?? NotSupplied)</dd>
                <dt>Cloud platform</dt>
                <dd>@(platform.CloudPlatform?.Value ?? NotSupplied)</dd>
                <dt>Region</dt>
                <dd>@(platform.Region?.Value ?? NotSupplied)</dd>
                <dt>Service</dt>
                <dd>@(platform.Service?.Value ?? NotSupplied)</dd>
                <dt>Revision</dt>
                <dd>@(platform.Revision?.Value ?? NotSupplied)</dd>
                <dt>Instance</dt>
                <dd>@(platform.Instance?.Value ?? NotSupplied)</dd>
            </dl>
        </section>

        <section>
            <h2>This run</h2>
            <dl>
                <dt>Session</dt>
                <dd><code>@session.Id</code></dd>
                <dt>Started</dt>
                <dd>@session.StartedOn.ToString("u", CultureInfo.InvariantCulture)</dd>
                <dt>Version</dt>
                <dd>@Model.Version.Value</dd>
                <dt>Environment</dt>
                <dd>@Model.EnvironmentName</dd>
            </dl>
        </section>

        <section>
            <h2>This request, as the application sees it</h2>
            <dl>
                <dt>Scheme</dt>
                <dd>@Model.RequestScheme</dd>
                <dt>Host</dt>
                <dd>@Model.RequestHost</dd>
                <dt>Remote address</dt>
                <dd>@(Model.RemoteAddress ?? NotSupplied)</dd>
            </dl>
            <p class="note">Behind a platform's proxy, the scheme and the remote address are the caller's only when forwarded
                headers are honored.</p>
        </section>

        <section>
            <h2>Routes to try</h2>
            <ul>
                <li><a href="/healthz/ping">/healthz/ping</a>: liveness, always <code>up</code></li>
                <li><a href="/healthz/ready">/healthz/ready</a>: readiness</li>
                <li><a href="/healthz/error/500">/healthz/error/500</a>: fails on purpose with 500</li>
                <li><a href="/healthz/error/403">/healthz/error/403</a>: refuses on purpose with 403</li>
                <li><a href="/api/notes">/api/notes</a>: every note</li>
                <li><a href="/api/notes/1">/api/notes/1</a>: the first seeded note</li>
            </ul>
        </section>
    </main>
</body>
</html>
